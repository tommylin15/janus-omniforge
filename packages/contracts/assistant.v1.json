{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Janus private assistant contracts",
  "version": "1.1.0",
  "definitions": {
    "RuntimeBindingV1": {
      "type": "object",
      "required": ["runtime", "model", "assistantProfile", "modelCapabilities"],
      "properties": {
        "runtime": {"enum": ["openrouter", "gemini", "codex"]},
        "model": {"type": "string", "minLength": 1},
        "assistantProfile": {"type": "string", "minLength": 1},
        "skillProfile": {"type": ["string", "null"], "minLength": 1},
        "modelCapabilities": {
          "type": "array",
          "items": {"enum": ["streaming", "tools", "grounding", "citations", "items", "approvals", "managed_auth"]},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "AgentEventV1": {
      "type": "object",
      "required": ["eventId", "seq", "threadId", "turnId", "type", "payload"],
      "properties": {
        "eventId": {"type": "string", "minLength": 1},
        "seq": {"type": "integer", "minimum": 0},
        "threadId": {"type": "string", "minLength": 1},
        "turnId": {"type": "string", "minLength": 1},
        "itemId": {"type": ["string", "null"], "minLength": 1},
        "providerIds": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "type": {"enum": ["text_delta", "item_upsert", "tool_request", "tool_result", "approval_request", "approval_resolved", "citation", "usage", "turn_completed", "turn_cancelled", "turn_error"]},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "ContextEgressV1": {
      "type": "object",
      "required": ["ownerId", "threadId", "runtime", "sourceIds", "containsPrivateData", "providerDisclosed", "privateDataConsent"],
      "properties": {
        "ownerId": {"type": "string", "minLength": 1},
        "threadId": {"type": "string", "minLength": 1},
        "runtime": {"enum": ["openrouter", "gemini", "codex"]},
        "sourceIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "containsPrivateData": {"type": "boolean"},
        "providerDisclosed": {"const": true},
        "privateDataConsent": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ApprovalRequestV1": {
      "type": "object",
      "required": ["ownerId", "threadId", "turnId", "requestId", "operation", "scope", "paramsDigest", "expiresAt"],
      "properties": {
        "ownerId": {"type": "string", "minLength": 1},
        "threadId": {"type": "string", "minLength": 1},
        "turnId": {"type": "string", "minLength": 1},
        "requestId": {"type": "string", "minLength": 1},
        "operation": {"type": "string", "minLength": 1, "not": {"enum": ["admin", "mutate_trade", "mutate_note", "mutate_watchlist", "place_order"]}},
        "scope": {"type": "string", "minLength": 1},
        "paramsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "expiresAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "ContextSourceV1": {
      "type": "object",
      "required": ["sourceId", "kind", "capabilities", "asOf", "freshness", "ownerScope", "status", "quota", "disclosure"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
        "kind": {"enum": ["core", "private_core", "private_mart", "external"]},
        "capabilities": {"type": "array", "items": {"enum": ["preview", "date_range"]}, "uniqueItems": true},
        "asOf": {"type": ["string", "null"], "format": "date-time"},
        "freshness": {"type": "string", "minLength": 1},
        "ownerScope": {"enum": ["public", "owner"]},
        "status": {"enum": ["available", "stale", "quota_exhausted", "unavailable"]},
        "quota": {
          "type": "object",
          "required": ["maxRecords", "maxRangeDays", "maxOutputBytes"],
          "properties": {
            "maxRecords": {"type": "integer", "minimum": 1, "maximum": 20},
            "maxRangeDays": {"type": "integer", "minimum": 1, "maximum": 366},
            "maxOutputBytes": {"type": "integer", "minimum": 1, "maximum": 32768}
          },
          "additionalProperties": false
        },
        "disclosure": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ContextSelectorV1": {
      "type": "object",
      "required": ["sourceId", "resource"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
        "resource": {"type": "string", "pattern": "^[a-z0-9-]{1,40}$"},
        "symbol": {"type": ["string", "null"], "pattern": "^[0-9A-Z._-]{1,20}$"},
        "startDate": {"type": ["string", "null"], "format": "date"},
        "endDate": {"type": ["string", "null"], "format": "date"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 10}
      },
      "additionalProperties": false
    },
    "ContextPreviewV1": {
      "type": "object",
      "required": ["sourceId", "resource", "preview", "asOf", "provenance", "contextRef", "expiresAt"],
      "properties": {
        "sourceId": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "preview": {"type": "array", "maxItems": 20, "items": {"type": "object"}},
        "asOf": {"type": ["string", "null"]},
        "provenance": {"type": "array", "items": {"type": "object"}},
        "contextRef": {"type": "string", "minLength": 32},
        "expiresAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "ContextResolveV1": {
      "type": "object",
      "required": ["ownerId", "threadId", "turnId", "contextRefs"],
      "properties": {
        "ownerId": {"type": "string", "format": "uuid"},
        "threadId": {"type": "string", "minLength": 1, "maxLength": 128},
        "turnId": {"type": "string", "minLength": 1, "maxLength": 128},
        "contextRefs": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 32}}
      },
      "additionalProperties": false
    }
  }
}
