name: Janus governance C0-Live bounded metadata read-only
on:
  push:
    branches: [main]
    paths:
      - '.github/workflows/governance-metadata-readonly.yml'
      - 'ops/governance-metadata-readonly-request.json'
  workflow_dispatch:
permissions:
  contents: read
  id-token: write
concurrency:
  group: janus-governance-metadata-readonly
  cancel-in-progress: false

jobs:
  audit-mode:
    runs-on: ubuntu-latest
    outputs:
      readers_only: ${{ steps.mode.outputs.readers_only }}
    steps:
      - uses: actions/checkout@v4
      - id: mode
        name: Select bounded C1-A reader audit without legacy P0-2 query
        run: |
          python - <<'PY'
          import json, os
          from pathlib import Path
          request=json.loads(Path("ops/governance-metadata-readonly-request.json").read_text())
          assert request.get("intent")=="c0-live-readonly-governance-metadata"
          assert request.get("scope")=="existing-dev"
          assert request.get("read_only") is True
          assert request.get("no_data_mutation") is True
          assert request.get("no_template_mutation") is True
          assert request.get("no_private_row_data") is True
          assert request.get("no_new_resources") is True
          assert request.get("no_iam_expansion") is True
          assert request.get("execution_count")==1
          scope=request.get("audit_focus")
          only=scope in ("c1a-reader-dependency-get-only-20261024",
                         "c1a-live-table-reader-recovery-20261024")
          if not only and scope!="p02-57-no-lease-execution-evidence-20261023-retry-2":
              raise ValueError("unknown governance audit focus")
          with open(os.environ["GITHUB_OUTPUT"],"a") as output:
              output.write("readers_only="+str(only).lower()+"\n")
          PY
  mart-reader-readonly:
    needs: audit-mode
    if: needs.audit-mode.outputs.readers_only == 'true'
    runs-on: ubuntu-latest
    environment: dev
    timeout-minutes: 12
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Test safe GET-only Mart reader scanner
        run: |
          python -m pip install -q pytest
          python -m pytest -q tests/test_governance_mart_reader_inventory.py
      - uses: ./.github/actions/setup-janus
        with:
          install-deps: none
          wif-provider: ${{ vars.GCP_WIF_PROVIDER }}
          service-account: ${{ vars.GCP_CI_SERVICE_ACCOUNT }}
      - name: Run bounded Core/Mart current snapshot and GCP logging reader evidence
        if: ${{ hashFiles('ops/governance-metadata-readonly-request.json') != '' }}
        run: |
          if [[ "$(python -c 'import json;print(json.load(open("ops/governance-metadata-readonly-request.json"))["audit_focus"])')" == "c1a-live-table-reader-recovery-20261024" ]]; then
            python -m pytest -q tests/test_governance_c1a_live_proof.py
            python scripts/gcp/governance_c1a_live_proof.py
          fi
      - name: Recheck main reader references and deployed metadata without SQL/job execution
        run: python scripts/gcp/governance_mart_reader_inventory.py
      - name: Validate bounded evidence and explicitly preserve unknown reader status
        run: |
          python - <<'PY'
          import json,os
          from pathlib import Path
          x=json.loads(Path("governance-mart-reader-inventory.json").read_text())
          assert x["source_git_sha"]==os.environ["GITHUB_SHA"]
          assert x["read_only"] is True
          assert x["data_mutations"]==x["iam_changes"]==x["new_resources"]==0
          assert x["actual_per_table_reader_usage"]=="UNKNOWN_NO_TABLE_LEVEL_RUNTIME_TRACE"
          assert x["no_literal_hit_means_no_reader"] is False
          assert len(x["references_by_table"])==10
          assert len(x["deployed_readers"])==3
          print(json.dumps({"status":x["status"],"scanned_files":x["scanned_files"],
              "deployed_readers":x["deployed_readers"],
              "table_names":sorted(x["references_by_table"]),
              "actual_reader_usage":x["actual_per_table_reader_usage"],
              "data_mutations":0},sort_keys=True))
          PY
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: janus-c1a-reader-dependency-get-only
          path: |
            governance-mart-reader-inventory.json
            governance-c1a-live-proof.json
          if-no-files-found: ignore
          retention-days: 14
  metadata-readback:
    needs: audit-mode
    if: needs.audit-mode.outputs.readers_only != 'true'
    runs-on: ubuntu-latest
    environment: dev
    timeout-minutes: 18
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - id: guard
        name: Offline read-only contract tests and fixed request guard
        run: |
          set -euo pipefail
          python -m pip install pytest -q
          python -m pytest -q tests/test_governance_metadata_readonly.py tests/test_governance_mart_metadata_readonly.py tests/test_governance_job_reconcile_readonly.py tests/test_governance_mart_reader_inventory.py
          python - <<'PY'
          import json
          from scripts.gcp.governance_metadata_readonly import validate_request
          with open('ops/governance-metadata-readonly-request.json',encoding='utf-8') as f:
              req=json.load(f)
          validate_request(req)
          assert req['no_new_resources'] is True
          assert req['no_iam_expansion'] is True
          assert req['execution_count'] == 1
          PY
      - id: setup
        uses: ./.github/actions/setup-janus
        with:
          install-deps: none
          wif-provider: ${{ vars.GCP_WIF_PROVIDER }}
          service-account: ${{ vars.GCP_CI_SERVICE_ACCOUNT }}
      - name: Read PG schema and Core/Mart Iceberg metadata with existing dev identity
        run: |
          python scripts/gcp/governance_metadata_readonly.py
      - name: Read Mart metadata via existing Mart identity even if Core is partial
        if: ${{ always() && steps.guard.outcome == 'success' && steps.setup.outcome == 'success' }}
        run: |
          python scripts/gcp/governance_mart_metadata_readonly.py
      - name: Reconcile bounded PG leases with existing Cloud Run Job executions (GET only)
        run: |
          python scripts/gcp/governance_job_reconcile_readonly.py
      - name: Enumerate code references and deployed Mart reader metadata (GET only)
        run: |
          python scripts/gcp/governance_mart_reader_inventory.py
      - name: Cross-validate PG/Core and Mart identity receipts
        run: |
          python - <<'PY'
          import json
          import os
          from pathlib import Path
          c=json.loads(Path('governance-metadata-readonly-receipt.json').read_text())
          m=json.loads(Path('governance-mart-metadata-readonly-receipt.json').read_text())
          j=json.loads(Path('governance-job-reconcile-readonly-receipt.json').read_text())
          reader=json.loads(Path('governance-mart-reader-inventory.json').read_text())
          assert reader['source_git_sha']==os.environ['GITHUB_SHA']
          assert reader['read_only'] is True and reader['data_mutations']==0
          assert len(reader['references_by_table'])==10
          assert reader['no_literal_hit_means_no_reader'] is False
          assert reader['actual_per_table_reader_usage']=='UNKNOWN_NO_TABLE_LEVEL_RUNTIME_TRACE'
          assert j['source_git_sha']==os.environ['GITHUB_SHA']
          assert j['read_only'] is True and j['status']=='PASS'
          assert j['data_mutations']==j['iam_changes']==j['new_resources']==0
          assert all(row['pagination_complete'] for row in j['cloud_run_job_last_30d'])
          for key in ('control_nonterminal_lease_30d',
                      'control_nonterminal_occurrence_link_30d',
                      'control_active_batch_occurrences_30d',
                      'control_nonterminal_rows_30d',
                      'control_p02_execution_decisions_30d',
                      'control_ledger_backup_reconcile_30d'):
              assert c['sections'][key]['status']=='PASS'

          assert c['source_git_sha']==m['git_sha']==os.environ['GITHUB_SHA']
          assert c['data_mutations']==m['data_mutations']==0
          assert c['job_configuration_unchanged'] is True
          assert m['job_configuration_unchanged'] is True
          required=('pg_relations','pg_columns','pg_constraints','pg_indexes',
                    'information_schema_tables','information_schema_columns',
                    'iceberg_catalog','schema_migrations')
          assert all(c['sections'][x]['status']=='PASS' for x in required)
          catalogue=c['sections']['iceberg_catalog']['items']
          core=sorted('core.'+r[2] for r in catalogue if r[1]=='core')
          mart=sorted('mart.'+r[2] for r in catalogue if r[1]=='mart')
          assert len(core)==9 and len(mart)==11
          core_detail=c['sections']['iceberg_snapshots']['items']
          assert {x['name'] for x in core_detail if x['status']=='READABLE'}>=set(core)
          mart_detail=m['sections']['mart_snapshots']['items']
          assert sorted(x['name'] for x in mart_detail)==mart
          assert all(x['status']=='READABLE' for x in mart_detail)
          assert m['sections']['summary']['items'][0]['status']=='PASS'
          summary={'component':'janus_governance_c0_live_metadata_join_v1',
                   'status':'PASS','source_git_sha':os.environ['GITHUB_SHA'],
                   'core_catalog_tables':len(core),'mart_catalog_tables':len(mart),
                   'core_snapshots_readable':len(core),'mart_metadata_readable':len(mart),
                   'postgres_relations':len(c['sections']['pg_relations']['items']),
                   'postgres_columns':len(c['sections']['pg_columns']['items']),
                   'postgres_constraints':len(c['sections']['pg_constraints']['items']),
                   'postgres_indexes':len(c['sections']['pg_indexes']['items']),
                   'applied_migrations':len(c['sections']['schema_migrations']['items']),
                   'data_mutations':0,'iam_changes':0,'new_resources':0}
          # C1-A reader/reference scope is a distinct, bounded gate.
          # Absence of recent published rows does NOT imply no active reader.
          for key in ('control_execution_30d','mart_table_identifier_constraint',
                      'publication_pg_scan_cumulative'):
              assert c['sections'][key]['status']=='PASS', key
          for key in ('publication_index_all','publication_index_30d',
                      'publication_p02_execution_refs_30d'):
              assert m['sections'][key]['status']=='PASS', key
          p02_ref_list=c['sections']['control_p02_execution_decisions_30d']['items']
          pending={r[0] for r in p02_ref_list if r[1]=='analysis'}
          published={r[0] for r in m['sections']['publication_p02_execution_refs_30d']['items']}
          summary.update(p02_analysis_queued=len(pending),
                         p02_analysis_publication_overlap=len(pending & published),
                         p02_analysis_without_publication=len(pending - published))
          constraints=c['sections']['mart_table_identifier_constraint']['items']
          assert len(constraints)==1
          assert constraints[0][0]=='mart_report_index_table_identifier_check'
          assert 'mart.mart_scoped_analysis_v1' in constraints[0][1]
          assert len(c['sections']['publication_pg_scan_cumulative']['items'])==2
          summary.update(mart_code_scan_status=reader['status'],
                         mart_code_scan_files=reader['scanned_files'],
                         mart_reader_literal_tables_with_refs=sum(
                             bool(v) for v in reader['references_by_table'].values()))
          p02=c['sections']['control_p02_execution_decisions_30d']['items']
          original=c['sections']['control_nonterminal_rows_30d']['items']
          assert len(p02)==len(original)
          assert {v[0] for v in p02}=={v[0] for v in original}
          from collections import Counter
          classifications=dict(Counter(v[16] for v in p02))
          summary.update(p02_total=len(p02),p02_classifications=classifications,
                         p02_verified_terminal_mutations=0,
                         p02_unproven_not_forced_failed=True)
          summary.update(per_execution_receipts=len(original),
                         ledger_backup_active_reconciliation=len(c['sections']['control_ledger_backup_reconcile_30d']['items']),
                         scheduler_metadata_status=j['scheduler']['status'],
                         pg_to_cloud_exact_join=j['pg_to_cloud_full_row_join'])
          summary.update(lease_job_reconcile_status=j['status'],
                         nonterminal_lease_groups=len(j['control_pg_lease_groups']),
                         nonterminal_occurrence_link_groups=len(j['control_pg_occurrence_link_groups']),
                         controller_active_refs=len(j['controller_active_refs']),
                         cloud_run_job_execution_scopes=len(j['cloud_run_job_last_30d']))
          summary.update(reader_reference_status='PASS',
                         control_occurrence_30d_groups=len(
                             c['sections']['control_execution_30d']['items']),
                         publication_index_all_groups=len(
                             m['sections']['publication_index_all']['items']),
                         publication_index_30d_groups=len(
                             m['sections']['publication_index_30d']['items']),
                         publication_index_total_refs=sum(int(r[3]) for r in
                             m['sections']['publication_index_all']['items']),
                         publication_index_30d_refs=sum(int(r[3]) for r in
                             m['sections']['publication_index_30d']['items']))
          Path('governance-metadata-joined-summary.json').write_text(
             json.dumps(summary,ensure_ascii=False,sort_keys=True,indent=2))
          print(json.dumps(summary,ensure_ascii=False,sort_keys=True))
          PY
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: janus-governance-metadata-readonly
          path: |
            governance-metadata-readonly-receipt.json
            governance-mart-metadata-readonly-receipt.json
            governance-metadata-joined-summary.json
            governance-job-reconcile-readonly-receipt.json
            governance-mart-reader-inventory.json
          retention-days: 14
          if-no-files-found: ignore
