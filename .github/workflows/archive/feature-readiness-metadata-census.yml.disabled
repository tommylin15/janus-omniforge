name: Janus one-shot read-only Core readiness census
on:
  push:
    branches: [main]
    paths: ['.github/workflows/feature-readiness-metadata-census.yml', 'ops/drl-01-readonly-census-request.json']
  workflow_dispatch:  # Independent bounded, read-only post-repair Core audit
permissions:
  contents: read
  id-token: write
concurrency:
  group: janus-dev-read-only-census
  cancel-in-progress: false
jobs:
  audit:
    runs-on: ubuntu-latest
    environment: dev
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - name: Verify approved read-only audit scope
        run: |
          python - <<'PY'
          import json
          r=json.load(open('ops/drl-01-readonly-census-request.json'))
          assert r['intent']=='drl01-readonly-core-coverage-audit' and r['approved'] is True
          assert r['read_only'] is True and r['no_owner_mutation'] is True
          assert r['no_job_template_mutation'] is True
          assert r['revenue_window_start']=='2025-09' and r['revenue_window_end']=='2026-09'
          PY
      - uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ vars.GCP_WIF_PROVIDER }}
          service_account: ${{ vars.GCP_CI_SERVICE_ACCOUNT }}
      - uses: google-github-actions/setup-gcloud@v2
      - name: Run existing dev Job with read-only execution args
        run: |
          python - <<'PY'
          import json,sys,time,subprocess
          from pathlib import Path
          sys.path.insert(0,'scripts/gcp')
          from ghcr_jobs_rollout import cloud,job,terminal,ROOT
          CODE=r"""
          import json,os
          from datetime import datetime,timezone
          from ingestion_core.__main__ import _control_plane,_iceberg_core
          from ingestion_core.iceberg_maintenance import _logical_periods
          report={'component':'feature_readiness_inventory','read_only':True,'status':'PARTIAL',
                  'scope':'current_catalog_snapshot','checked_at':datetime.now(timezone.utc).isoformat(),
                  'markets':[],'tables':[]}
          control=None
          core=None
          try:
              control=_control_plane()
              with control.connection.cursor() as c:
                  c.execute("SELECT market,count(*)::bigint,count(*) FILTER(WHERE enabled)::bigint FROM control.stock_master WHERE market IN ('TWSE','TPEX') GROUP BY market ORDER BY market")
                  report['markets']=[{'market':m,'all':int(n),'enabled':int(e)} for m,n,e in c.fetchall()]
                  c.execute("SELECT market,symbol FROM control.stock_master WHERE enabled AND market IN ('TWSE','TPEX')")
                  market_members={'TWSE':set(),'TPEX':set()}
                  for market,symbol in c.fetchall():
                      market_members[str(market)].add(str(symbol))
              core=_iceberg_core(os.environ['CORE_BUCKET'],read_only=True)
              for dataset in core.IDENTIFIERS:
                  item={'dataset':dataset}
                  try:
                      if not core.table_exists(dataset):
                          item['status']='MISSING'
                      else:
                          t=core.catalog.load_table(core.table_identifier(dataset))
                          s=t.current_snapshot()
                          item['snapshot_id']=str(s.snapshot_id) if s else None
                          item['total_records']=int(s.summary['total-records']) if s and 'total-records' in (s.summary or {}) else None
                          item['schema_fields']=[f.name for f in t.schema().fields]
                          item['status']='COUNTED' if item['total_records'] is not None else 'UNKNOWN'
                          try:
                              field,transform=core.PARTITIONS[dataset][0]
                              periods=_logical_periods(t,field,transform)
                              item['partition_count']=len(periods)
                              item['earliest_partition']=periods[0]['period'] if periods else None
                              item['latest_partition']=periods[-1]['period'] if periods else None
                              item['partition_records']=sum(x['record_count'] for x in periods)
                              item['partition_total_matches']=item['partition_records']==item['total_records']
                          except Exception as e:
                              item['partition_error']=type(e).__name__
                  except Exception as e:
                      item['status']='ERROR_'+type(e).__name__
                  report['tables'].append(item)
              from collections import defaultdict,Counter
              import time
              report['feature_depth']={}
              start_detail=time.monotonic()
              for dataset,fields in (
                  ('ohlcv',('symbol','market','trade_date','close')),
                  ('valuation',('symbol','market','observed_date','pe_ratio','pb_ratio')),
                  ('financials',('symbol','fiscal_year','fiscal_quarter','fiscal_month','statement_type','metric','value','period_basis','is_single_quarter','unit','source_id','provenance_id','availability_at'))):
                  detail={'status':'PENDING','row_limit':180000}
                  try:
                      if time.monotonic()-start_detail>210:
                          detail['status']='SKIPPED_TIME_BUDGET'
                      else:
                          table=core.catalog.load_table(core.table_identifier(dataset))
                          snapshot=table.current_snapshot()
                          records=table.scan(snapshot_id=snapshot.snapshot_id,selected_fields=fields,limit=180000).to_arrow().to_pylist()
                          detail['scanned_rows']=len(records)
                          detail['snapshot_rows']=int(snapshot.summary['total-records'])
                          if len(records)!=detail['snapshot_rows']:
                              detail['status']='PARTIAL_ROW_MISMATCH'
                          elif dataset in ('ohlcv','valuation'):
                              days=defaultdict(set)
                              for row in records:
                                  symbol=str(row.get('symbol') or '')
                                  market=str(row.get('market') or '')
                                  valid=row.get('close') if dataset=='ohlcv' else row.get('pe_ratio')
                                  dateval=row.get('trade_date') if dataset=='ohlcv' else row.get('observed_date')
                                  if market in ('TWSE','TPEX') and symbol and valid is not None and dateval is not None:
                                      days[(market,symbol)].add(str(dateval))
                              detail['markets']={}
                              for market in ('TWSE','TPEX'):
                                  sets=[v for (m,s),v in days.items() if m==market]
                                  market_dates=sorted(set().union(*sets)) if sets else []
                                  recent=set(market_dates[-20:])
                                  detail['markets'][market]={
                                      'symbols_with_metric':len(sets),
                                      'count_at_least_9':sum(len(v)>=9 for v in sets),
                                      'count_at_least_11':sum(len(v)>=11 for v in sets),
                                      'count_at_least_20':sum(len(v)>=20 for v in sets),
                                      'recent_21_dates_from_metric':len(set(market_dates[-21:])),
                                      'count_at_least_20_of_recent_21':sum(
                                          len(v.intersection(market_dates[-21:]))>=20 for v in sets),
                                      'count_at_least_60':sum(len(v)>=60 for v in sets),
                                      'count_at_least_120':sum(len(v)>=120 for v in sets),
                                      'count_at_least_250':sum(len(v)>=250 for v in sets),
                                      'count_at_least_750':sum(len(v)>=750 for v in sets),
                                      'recent_20_dates_available':len(recent)==20,
                                      'has_all_recent_20_dates':sum(len(recent)==20 and recent<=v for v in sets),
                                      'earliest_date':market_dates[0] if market_dates else None,
                                      'latest_date':market_dates[-1] if market_dates else None}
                              detail['status']='PASS_BY_MARKET_HISTORY'
                          else:
                              revenue=defaultdict(set)
                              eps=defaultdict(set)
                              single_eps=defaultdict(set)
                              stmts=Counter()
                              for row in records:
                                  symbol=str(row.get('symbol') or '')
                                  if not symbol:continue
                                  stmt=str(row.get('statement_type') or '')
                                  metric=str(row.get('metric') or '')
                                  stmts[stmt]+=1
                                  if stmt=='monthly_revenue' and row.get('fiscal_month') and row.get('value') is not None:
                                      revenue[symbol].add((int(row['fiscal_year']),int(row['fiscal_month'])))
                                  if ('eps' in metric.lower() or '每股盈餘' in metric) and row.get('value') is not None:
                                      q=(int(row['fiscal_year']),int(row['fiscal_quarter']))
                                      eps[symbol].add(q)
                                      if row.get('is_single_quarter') is True or str(row.get('period_basis') or '') in ('quarter','single_quarter'):
                                          single_eps[symbol].add(q)
                              detail['monthly_revenue_unkeyed_rows']=sum(
                                  str(row.get('statement_type') or '')=='monthly_revenue'
                                  and row.get('fiscal_month') is None for row in records)
                              detail['monthly_revenue_keyed_rows']=sum(
                                  str(row.get('statement_type') or '')=='monthly_revenue'
                                  and row.get('fiscal_month') is not None for row in records)
                              detail['financial_statement_counts']=dict(stmts.most_common(15))
                              detail['monthly_revenue']={
                                  'symbols_any_month':len(revenue),
                                  'symbols_13_months':sum(len(v)>=13 for v in revenue.values()),
                                  'symbols_24_months':sum(len(v)>=24 for v in revenue.values()),
                                  'symbols_any_yoy_pair':sum(any((y-1,m) in v for y,m in v) for v in revenue.values())}
                              detail['eps']={
                                  'symbols_any_eps':len(eps),
                                  'symbols_4_quarters':sum(len(v)>=4 for v in eps.values()),
                                  'symbols_12_quarters':sum(len(v)>=12 for v in eps.values()),
                                  'symbols_4_explicit_single_quarters':sum(len(v)>=4 for v in single_eps.values())}
                              from decimal import Decimal, InvalidOperation
                              official_revenue=defaultdict(set)
                              official_quarters=defaultdict(set)
                              for row in records:
                                  symbol=str(row.get('symbol') or '')
                                  if (row.get('source_id')!='mops' or not row.get('provenance_id')
                                      or not row.get('availability_at')):continue
                                  try:
                                      if not Decimal(str(row.get('value'))).is_finite():continue
                                      year=int(row['fiscal_year'])
                                      month=int(row['fiscal_month']) if row.get('fiscal_month') else None
                                      quarter=int(row['fiscal_quarter']) if row.get('fiscal_quarter') else None
                                  except (TypeError,ValueError,InvalidOperation):continue
                                  metric=str(row.get('metric') or '')
                                  basis=str(row.get('period_basis') or '')
                                  if (row.get('statement_type')=='monthly_revenue'
                                      and metric=='monthly_revenue' and basis=='monthly'
                                      and row.get('unit')=='TWD_thousands' and month and 1<=month<=12):
                                      official_revenue[symbol].add((year,month))
                                  if row.get('unit')=='TWD_per_share' and quarter and 1<=quarter<=4:
                                      if (metric=='eps_single_quarter' and basis=='single_quarter'
                                          or quarter==1 and basis in ('','year_to_date')
                                          and ('每股盈餘' in metric or metric=='eps_year_to_date')):
                                          official_quarters[symbol].add((year,quarter))
                              expected_months=(
                                  {(2025,m) for m in range(9,13)}
                                  | {(2026,m) for m in range(1,10)})
                              rev_market={}
                              eps_market={}
                              for market,members in market_members.items():
                                  n=len(members)
                                  rev_count=sum(expected_months<=official_revenue[s] for s in members)
                                  eps_count=0
                                  for symbol in members:
                                      indices={y*4+q-1 for y,q in official_quarters[symbol]}
                                      eps_count+=int(any(
                                          {i,i-1,i-2,i-3}<=indices for i in indices))
                                  threshold=.9 if market=='TWSE' else .7
                                  rev_market[market]={
                                      'denominator':n,'qualified':rev_count,
                                      'coverage':round(rev_count/n,6) if n else None,
                                      'threshold':threshold,
                                      'status':'PASS' if n and rev_count/n>=threshold else 'PARTIAL'}
                                  eps_market[market]={
                                      'denominator':n,'contiguous_four_quarters':eps_count,
                                      'coverage':round(eps_count/n,6) if n else None}
                              detail['drl01_official_13_month_consecutive']={
                                  'window':'2025-09..2026-09',
                                  'by_market':rev_market,
                                  'status':'PASS' if all(x['status']=='PASS' for x in rev_market.values())
                                               else 'PARTIAL'}
                              detail['drl01_official_4_comparable_quarters']={
                                  'by_market':eps_market,'status':'MEASURED_ONLY'}
                              # Read-only audit of official 2382 EPS after bounded
                              # DRL-01 canary: never publish source-unverified YTD
                              # EPS subtraction as single-quarter fact.
                              quarterly=set()
                              for row in records:
                                  if (str(row.get('symbol'))!='2382'
                                      or row.get('source_id')!='mops'
                                      or not row.get('provenance_id')
                                      or not row.get('availability_at')
                                      or row.get('unit')!='TWD_per_share'
                                      or row.get('value') is None):
                                      continue
                                  try:
                                      from decimal import Decimal
                                      if not Decimal(str(row['value'])).is_finite():continue
                                      y,q=int(row['fiscal_year']),int(row['fiscal_quarter'])
                                  except (ValueError,TypeError):continue
                                  if ((row.get('metric')=='eps_single_quarter' and row.get('period_basis')=='single_quarter')
                                      or (q==1 and row.get('period_basis') in (None,'year_to_date')
                                          and ('每股盈餘' in str(row.get('metric') or '')
                                               or row.get('metric')=='eps_year_to_date'))):
                                      quarterly.add((y,q))
                              detail['drl01_2382_provable_single_quarters']=[
                                  f'{year}Q{quarter}' for year,quarter in sorted(quarterly)]
                              detail['drl01_2382_four_quarters_contiguous'] = any(
                                  {i,i-1,i-2,i-3} <= {y*4+q-1 for y,q in quarterly}
                                  for i in (y*4+q-1 for y,q in quarterly))
                              detail['status']='PASS_FINANCIAL_PERIOD_COUNTS'
                  except Exception as error:
                      detail['status']='ERROR_'+type(error).__name__
                  report['feature_depth'][dataset]=detail
              report['status']='PASS' if len(report['tables'])==len(core.IDENTIFIERS) and all(x['status'] in ('COUNTED','MISSING') for x in report['tables']) else 'PARTIAL'
          except Exception as e:
              report['status']='BLOCKED_'+type(e).__name__
          finally:
              if core is not None:
                  try:core.close()
                  except Exception:pass
              if control is not None:
                  try:control.close()
                  except Exception:pass
              print(json.dumps(report,ensure_ascii=False,sort_keys=True),flush=True)
          """
          j=job('janus-ingestion-core')
          c=j['template']['template']['containers']
          if len(c)!=1 or c[0].get('command') not in (None,[],['python']):
              raise ValueError('entrypoint_drift')
          override={'args':(['python'] if not c[0].get('command') else [])+['-c',CODE],
                    'env':[{'name':'QUEUE_CONSUMER','value':'false'}]}
          if c[0].get('name'):override['name']=c[0]['name']
          op=cloud(f'{ROOT}/jobs/janus-ingestion-core:run',
                   {'etag':j['etag'],'overrides':{'taskCount':1,'timeout':'450s','containerOverrides':[override]}},'POST')
          name=op.get('name','')
          if not name.startswith(ROOT+'/operations/'):raise ValueError('invalid_operation')
          until=time.monotonic()+515
          while not op.get('done') and time.monotonic()<until:
              time.sleep(6)
              op=cloud(name)
          if not op.get('done') or op.get('error'):raise RuntimeError('census_operation_failed')
          exe=op.get('response',{})
          if not terminal(exe) or exe.get('succeededCount')!=1 or exe.get('failedCount',0):
              raise RuntimeError('census_job_failed')
          exe_name=exe.get('name','').rsplit('/',1)[-1]
          if not exe_name.startswith('janus-ingestion-core-'):raise ValueError('bad_execution')
          query=f'resource.type="cloud_run_job" AND labels."run.googleapis.com/execution_name"="{exe_name}"'
          result=None
          for _ in range(5):
              proc=subprocess.run(['gcloud','logging','read',query,'--project=gen-lang-client-0593591102',
                                   '--limit=180','--format=json'],capture_output=True,text=True,timeout=40)
              if proc.returncode==0:
                  for row in json.loads(proc.stdout):
                      payload=row.get('jsonPayload')
                      if not isinstance(payload,dict):
                          try:payload=json.loads(row.get('textPayload',''))
                          except (ValueError,TypeError):continue
                      if isinstance(payload,dict) and payload.get('component')=='feature_readiness_inventory':
                          result=payload
                          break
              if result is not None:break
              time.sleep(5)
          if result is None:raise RuntimeError('census_receipt_missing')
          Path('/tmp/readiness_census.json').write_text(json.dumps(result,ensure_ascii=False,indent=2))
          print(json.dumps({'execution':exe_name,'receipt':result},ensure_ascii=False))
          if result.get('status')!='PASS':raise RuntimeError('census_partial')
          PY
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: readiness-census-metadata
          path: /tmp/readiness_census.json
          if-no-files-found: ignore
          retention-days: 7
