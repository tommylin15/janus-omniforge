# Local environment configuration. Keep the safe template tracked.
.env
.env.*
!.env.example

# Python virtual environments and generated files.
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tmp/

# Local editor overrides may contain machine-specific paths or credentials.
.amazonq/
/.cline*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.vscode/settings.json
.vscode/settings.local.json

# Node dependencies and generated frontend output.
node_modules/
.token-savior-cache.json
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
*.tsbuildinfo

# Browser profiles can contain cookies, tokens, and cached credentials.
tests/output/edge-profile/

# Generated browser-test reports and local logs.
frontend/playwright-report/
frontend/test-results/
*.log

# Terraform local state, plans, and downloaded providers.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# OS-generated metadata.
.DS_Store
Thumbs.db
Desktop.ini
google-user-oauth-dev.json
