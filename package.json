{
  "name": "janus-omniforge-admin",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && npm run lint && node scripts/build-web.mjs",
    "build:agent-gateway": "tsc -p services/agent-gateway/tsconfig.json",
    "build:mcp-fixture": "tsc -p services/mcp-fixture/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:agent-gateway": "vitest run tests/agent_gateway.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/server-legacy": "2.0.0",
    "@openai/codex": "0.153.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.22.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  }
}
